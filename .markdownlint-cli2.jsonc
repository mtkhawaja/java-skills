{
  "config": {
    // The repo wraps prose at ~100 and skill tables/code lines run long by design.
    "line-length": false,
    // Agent definitions (agents/*.md) are system prompts: frontmatter + prose, no H1.
    "first-line-heading": false
  },
  "ignores": [
    // Historical planning record, not shipped content.
    "docs/superpowers/plans/**",
    // Eval prompts/rubrics are verbatim model input, not rendered docs.
    "evals/*/*/**",
    // Local, git-ignored plan-execution scratch.
    ".superpowers/**",
    "node_modules/**"
  ]
}
